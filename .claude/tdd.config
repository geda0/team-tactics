# ─── team-tactics config — DATA ONLY (this project: the team-tactics package itself) ───
# team-tactics:config-schema=2
# team-tactics dogfoods its own harness. One layer: the package's node:test suite.
# Source = the shipped installer + kit payload (bin/, kit/); tests = test/*.test.js.

LAYERS="app"

ALL_TEST_CMD="npm test"

TEST_CMD_app="node --test"
TEST_GLOB_app='(^|/)test/.*\.test\.js$'
SRC_GLOB_app='(^|/)(bin|kit)/'

TAIL_LINES=40

# Dogfood: arm the context-map edit-time push (ADR 0019). Surfaces a path's crumbs on edit.
CONTEXT_MAP=1

# Dogfood ADR 0026: the fleet shares ONE bus across sessions and hosts — the tics-bus branch of this repo.
TIC_STORE="git"
TICS_REMOTE="https://github.com/geda0/team-tactics.git"
TICS_BRANCH="tics-bus"
