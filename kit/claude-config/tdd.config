# ─── TDD pairing config (project-agnostic) ────────────────────────
# Sourced by every hook. Define your project's test "layers" here. A layer is
# just a slice of the codebase with its own test command and file globs.
#
#   • Single-package project? Keep ONE layer (the default "app" below).
#   • Full-stack / monorepo?  Declare several (backend, frontend, e2e, …).
#
# The orchestrator writes the active layer to .claude/state/layer before each
# cycle; the hooks use the matching command + globs. Layer names must be valid
# shell identifiers (letters, digits, underscore): app, backend, frontend, e2e.
#
# This file is YOURS — the installer seeds it once and never overwrites it.

# Space-separated list of layers, in no particular order.
LAYERS="app"

# Full-suite gate used for the final "done" check (and as a fallback command).
ALL_TEST_CMD="npm test"

# Fallbacks used when a layer doesn't define its own glob.
DEFAULT_TEST_GLOB='(\.test\.|\.spec\.|(^|/)tests?/|(^|/)__tests__/)'
DEFAULT_SRC_GLOB='(^|/)src/'

# ── Per-layer definitions ─────────────────────────────────────────
# For each layer "X" set: TEST_CMD_X, TEST_GLOB_X, SRC_GLOB_X.
# (Globs are egrep regexes matched against the edited file path.)

# Default single layer — edit the command for your stack:
#   pytest:  TEST_CMD_app="pytest -q"
#   jest:    TEST_CMD_app="npx jest"
#   vitest:  TEST_CMD_app="npx vitest run"
#   go:      TEST_CMD_app="go test ./..."   (and globs below)
TEST_CMD_app="npm test"
TEST_GLOB_app="$DEFAULT_TEST_GLOB"
SRC_GLOB_app="$DEFAULT_SRC_GLOB"

# ── Full-stack example (uncomment & adapt; set LAYERS above) ───────
# LAYERS="backend frontend e2e"
# ALL_TEST_CMD="pnpm verify"
#
# TEST_CMD_backend="pnpm --filter @app/backend test"
# TEST_GLOB_backend='(^|/)backend/.*(\.test\.ts|\.spec\.ts)$'
# SRC_GLOB_backend='(^|/)backend/src/.*\.ts$'
#
# TEST_CMD_frontend="pnpm --filter @app/frontend test"
# TEST_GLOB_frontend='(^|/)frontend/.*(\.test\.tsx?|\.spec\.tsx?)$'
# SRC_GLOB_frontend='(^|/)frontend/src/.*\.(ts|tsx)$'
#
# TEST_CMD_e2e="pnpm --filter @app/e2e test"
# TEST_GLOB_e2e='(^|/)e2e/.*\.spec\.ts$'
# SRC_GLOB_e2e='(^|/)e2e/.*\.ts$'

# How many lines of failing output to surface back into the conversation.
TAIL_LINES=40

# ── SessionStart baseline check ───────────────────────────────────
# Warn (not block) if the baseline suite is red when a session starts.
# Set to 0 to disable; point BASELINE_CMD at a fast subset for big suites.
: "${SESSION_BASELINE_CHECK:=1}"
: "${BASELINE_CMD:=$ALL_TEST_CMD}"

# ── Cycle telemetry ───────────────────────────────────────────────
# Append one JSON event per suite run to TELEMETRY_FILE. Read it with
# `npx create-tdd-pairing report`. Set TELEMETRY=0 to disable.
: "${TELEMETRY:=1}"
# TELEMETRY_FILE defaults to <project>/.claude/state/telemetry.jsonl (set by the
# hook). Uncomment to override:
# TELEMETRY_FILE="/custom/path/telemetry.jsonl"

# ── Resolver (bash 3.2 safe — no associative arrays) ──────────────
# Sets TEST_CMD / TEST_GLOB / SRC_GLOB for the given layer, with fallbacks.
resolve_layer() {
  _l="$1"
  eval "TEST_CMD=\"\${TEST_CMD_${_l}:-}\""
  eval "TEST_GLOB=\"\${TEST_GLOB_${_l}:-}\""
  eval "SRC_GLOB=\"\${SRC_GLOB_${_l}:-}\""
  [ -n "$TEST_CMD" ]  || TEST_CMD="$ALL_TEST_CMD"
  [ -n "$TEST_GLOB" ] || TEST_GLOB="$DEFAULT_TEST_GLOB"
  [ -n "$SRC_GLOB" ]  || SRC_GLOB="$DEFAULT_SRC_GLOB"
}
