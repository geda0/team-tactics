{
  "name": "ttics",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ttics",
      "version": "0.0.0",
      "workspaces": [
        "packages/*"
      ],
      "bin": {
        "tics": "packages/team-tactics/bin/cli.js",
        "ttics": "packages/team-tactics/bin/cli.js"
      }
    },
    "node_modules/@ttics/tics": {
      "resolved": "packages/tics",
      "link": true
    },
    "node_modules/team-tactics": {
      "resolved": "packages/team-tactics",
      "link": true
    },
    "packages/team-tactics": {
      "version": "0.12.0",
      "license": "UNLICENSED",
      "dependencies": {
        "@ttics/tics": "*"
      },
      "bin": {
        "tics": "bin/cli.js"
      },
      "engines": {
        "node": ">=16"
      }
    },
    "packages/tics": {
      "name": "@ttics/tics",
      "version": "0.12.0",
      "license": "MIT",
      "bin": {
        "tics": "bin/tics.js"
      }
    }
  }
}
